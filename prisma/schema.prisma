generator client {
  provider = "prisma-client"
  output   = "generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TradeDirection {
  LONG
  SHORT
}

enum TradeStatus {
  PENDING
  FILLED
  PARTIAL
  CANCELLED
  REJECTED
}

enum OrderType {
  MARKET
  LIMIT
  STOP
  STOP_LIMIT
  TRAILING_STOP
}

enum PositionStatus {
  OPEN
  CLOSED
  EXPIRED
  STOPPED
}

enum StrategyStatus {
  DEVELOPMENT
  ACTIVE
  PAUSED
  RETIRED
}

enum StrategyCategory {
  INCOME
  SWING
  SCALP
  TREND
  BREAKOUT
  REVERSAL
}

enum Timeframe {
  INTRADAY
  DAILY
  WEEKLY
  MONTHLY
  POSITION
}

enum RiskProfile {
  LOW
  MODERATE
  HIGH
  SPECULATIVE
}

enum PostType {
  STRATEGY
  GENERIC
}

model Post {
  id              Int       @id @default(autoincrement())

  slug            String    @unique
  title           String
  date            DateTime  @default(now())
  content         String
  summary         String
  type            PostType

  seoTitle        String?
  seoDescription  String?

  strategy        Strategy?   @relation
}

model Strategy {
  id          Int             @id @default(autoincrement())
  PostId      Int?            @unique
  post        Post?           @relation(fields: [PostId], references: [id])

  name          String
  description   String
  category      StrategyCategory
  timeframe     Timeframe
  riskProfile   RiskProfile
  status        StrategyStatus

  positions     Position[]
  createdAt     DateTime         @default(now())
}

model Position {
  id              Int       @id @default(autoincrement())
  strategyId      Int
  strategy        Strategy  @relation(fields: [strategyId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  underlying      String
  status          PositionStatus
  openedAt        DateTime
  capitalUsed     Float

  closedAt        DateTime?
  realizedPnl     Float?
  unrealizedPnl   Float?
  returnPct       Float?
  thesis          String?
  notes           String?

  trades          Trade[]
  createdAt       DateTime        @default(now())
}

model Trade {
  id            Int            @id @default(autoincrement())

  positionId    Int
  position      Position       @relation(fields: [positionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  date          DateTime
  direction     TradeDirection
  orderType     OrderType
  status        TradeStatus
  quantity      Float

  limitPrice    Float?
  filledPrice   Float?
  fees          Float?
  slippage      Float?
  realizedPnl   Float?
  notes         String?
}

