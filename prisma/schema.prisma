generator client {
  provider = "prisma-client"
  output   = "generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PostType {
  STRATEGY
  GENERIC
  NOTEBOOK
  PDF
}

enum PfPositionType {
  STOCK
  CRYPTO
  CASH
}

model Post {
  id              String    @id

  slug            String    @unique
  title           String
  date            DateTime  @default(now())
  content         String
  summary         String
  type            PostType

  seoTitle        String?
  seoDescription  String?
  link            String?
}

model Portfolio {
  id            String         @id
  date          DateTime
  ticker        String
  quantity      Float
  type          PfPositionType
}

model Schedule {
  id              String   @id @default(cuid())
  start           String
  zone_durations  Int[]
  auto            Boolean
}

model DeviceLog {
  id          String   @id @default(cuid())
  messages    Bytes
  receivedAt  DateTime @default(now())

  @@index([receivedAt])
}
