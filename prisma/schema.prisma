generator client {
  provider = "prisma-client"
  output   = "generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OptionType {
  CALL
  PUT
}

enum TradeDirection {
  BUY
  SELL
}

enum TradeStatus {
  OPEN
  CLOSED
  EXPIRED
}

enum PostType {
  OPTIONS_STRATEGY
  GENERIC
}

model Post {
  id              Int     @id @default(autoincrement())
  slug            String  @unique
  title           String
  date            DateTime
  content         String
  summary         String
  type            PostType

  optionsStrategy OptionsStrategy?
}

model OptionsStrategy {
  id          Int             @id @default(autoincrement())
  PostId      Int             @unique
  post        Post            @relation(fields: [PostId], references: [id])

  date        DateTime
  underlying  String
  name        String
  status      TradeStatus
  netPremium  Float
  pnl         Float?

  legs        OptionsStrategyLeg[]
}

model OptionsStrategyLeg {
  id          Int               @id @default(autoincrement())

  strategyId  Int               
  strategy    OptionsStrategy   @relation(fields: [strategyId], references: [id])
  type        OptionType
  direction   TradeDirection
  strike      Float
  expiry      DateTime
  contracts   String[]
  premium     Float
}

